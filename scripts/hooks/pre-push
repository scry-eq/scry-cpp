#!/usr/bin/env bash
# Pre-push hook: re-build the daemon and run the tier-2 replay check
# against local fixtures so a code change that shifts the envelope
# stream can't slip out without me knowing. Also checks that
# scry-decoder-rs/bindings.rs is fresh whenever everquest.h changes.
#
# Bypass with: git push --no-verify
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "${REPO}"

# Capture stdin before it is consumed so we can inspect the push range.
PUSH_INFO="$(cat)"

# Static opcode-binding check first: it needs no build, runs in a second, and
# catches wiring/table drift on ALL THREE targets — including the two this
# checkout isn't currently built for. A mismatch here means the daemon silently
# decodes nothing for that opcode (see tools/bindcheck.py).
echo "pre-push: checking opcode bindings (all targets)..."
python3 tools/bindcheck.py

if [[ -d build ]]; then
    echo "pre-push: rebuilding daemon (incremental)..."
    cmake --build build --target scryd -j >/dev/null

    echo "pre-push: running tier-2 replay check..."
    echo "${PUSH_INFO}" | tests/replay/check.sh
else
    echo "pre-push: no build/ in $(pwd) — replay check skipped (run cmake -B build first)" >&2
fi

# ── Proto submodule sync check ───────────────────────────────────────────────
# The proto/ submodule must match canonical scry-proto. A pointer AHEAD of
# origin/proto (unpushed) leaves a dangling submodule that breaks clones/CI
# (the cross-repo push-order footgun); one BEHIND means the daemon — and scry,
# which regenerates its Elixir proto from this submodule — build against a stale
# schema. Fetch first: a stale cached origin/main will otherwise mislead the
# comparison (learned the hard way).
if [[ -d proto ]]; then
    if git -C proto fetch -q origin 2>/dev/null; then
        PROTO_SUB="$(git rev-parse HEAD:proto)"
        PROTO_CANON="$(git -C proto rev-parse origin/main)"
        if [[ "${PROTO_SUB}" == "${PROTO_CANON}" ]]; then
            echo "pre-push: proto submodule in sync (${PROTO_SUB:0:12})"
        elif git -C proto merge-base --is-ancestor "${PROTO_SUB}" "${PROTO_CANON}"; then
            echo "" >&2
            echo "ERROR: proto submodule is BEHIND canonical origin/proto." >&2
            echo "       committed ${PROTO_SUB:0:12}  →  canonical ${PROTO_CANON:0:12}" >&2
            echo "       Bump it: (cd proto && git fetch origin && git checkout origin/main) && git add proto" >&2
            echo "       then regenerate consumers (scry: protoc --elixir_out; web: bun run gen) and commit." >&2
            exit 1
        else
            echo "" >&2
            echo "ERROR: proto submodule ${PROTO_SUB:0:12} is not on origin/proto main." >&2
            echo "       Push scry-proto FIRST (cross-repo order: proto → daemon → web)." >&2
            exit 1
        fi
    else
        echo "pre-push: WARN could not fetch proto origin — proto-sync check skipped (offline?)" >&2
    fi
fi

# ── Decoder pin + protocol mirror checks ──────────────────────────────────────
DECODER_RS="${SEQ_DECODER_RS_DIR:-${REPO}/scry-decoder-rs}"
if [[ ! -d "${DECODER_RS}" ]]; then
    echo "ERROR: scry-decoder-rs submodule is not initialized at ${DECODER_RS}." >&2
    exit 1
fi

# A local gitlink can point at an unpushed decoder commit and still build from
# the developer's populated submodule. Prove the recorded commit is reachable
# from canonical origin/main before allowing the host commit to leave.
if ! git -C "${DECODER_RS}" fetch -q origin 2>/dev/null; then
    echo "ERROR: could not fetch decoder origin; refusing to skip gitlink reachability." >&2
    exit 1
fi
DECODER_SUB="$(git rev-parse HEAD:scry-decoder-rs)"
if ! git -C "${DECODER_RS}" merge-base --is-ancestor \
        "${DECODER_SUB}" origin/main 2>/dev/null; then
    echo "ERROR: decoder gitlink ${DECODER_SUB:0:12} is not reachable from origin/main." >&2
    echo "       Push scry-decoder-rs first, then retry the scry-cpp push." >&2
    exit 1
fi
echo "pre-push: decoder pin reachable (${DECODER_SUB:0:12})"

CATALOG_CHECK="${DECODER_RS}/seq-protocol-data/tools/import_host_catalogs.py"
if [[ ! -f "${CATALOG_CHECK}" ]]; then
    echo "ERROR: decoder catalog checker is missing at ${CATALOG_CHECK}." >&2
    exit 1
fi
echo "pre-push: checking Rust/C++ opcode catalog parity..."
python3 "${CATALOG_CHECK}" --check "${REPO}/conf"

# ── Rust bindings freshness check ────────────────────────────────────────────
if [[ ! -f "${DECODER_RS}/Cargo.toml" ]]; then
    echo "ERROR: decoder checkout at ${DECODER_RS} has no Cargo.toml." >&2
    exit 1
fi

# Check if any commit being pushed touched a backend's everquest.h. live and
# test share seq-decode, so a struct edit to either must regenerate BOTH sets
# of bindings — regenerating one alone breaks the other target's build.
EQ_H_CHANGED=0
while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ -z "${local_sha}" ]] && continue
    # remote_sha is 0000... for a new branch; treat as empty tree.
    if [[ "${remote_sha}" == "0000000000000000000000000000000000000000" ]]; then
        remote_sha="$(git hash-object -t tree /dev/null)"
    fi
    if git log --name-only "${remote_sha}..${local_sha}" \
            -- src/backend/live/everquest.h src/backend/test/everquest.h \
            | grep -q "everquest.h"; then
        EQ_H_CHANGED=1
        break
    fi
done <<< "${PUSH_INFO}"

if [[ "${EQ_H_CHANGED}" -eq 0 ]]; then
    exit 0
fi

echo "pre-push: everquest.h changed — verifying Rust bindings are fresh..."

STALE=0
SAVED_LIVE="$(mktemp)"
SAVED_TEST="$(mktemp)"
BINDINGS_LIVE="${DECODER_RS}/seq-structs-live/src/bindings.rs"
BINDINGS_TEST="${DECODER_RS}/seq-structs-test/src/bindings.rs"

for B in "${BINDINGS_LIVE}" "${BINDINGS_TEST}"; do
    if [[ ! -f "${B}" ]]; then
        echo "ERROR: expected generated bindings at ${B}" >&2
        echo "       (the freshness check cannot run — is the crate renamed?)" >&2
        rm -f "${SAVED_LIVE}" "${SAVED_TEST}"
        exit 1
    fi
done

cp "${BINDINGS_LIVE}" "${SAVED_LIVE}"
cp "${BINDINGS_TEST}" "${SAVED_TEST}"

restore_bindings() {
    cp "${SAVED_LIVE}" "${BINDINGS_LIVE}"
    cp "${SAVED_TEST}" "${BINDINGS_TEST}"
    rm -f "${SAVED_LIVE}" "${SAVED_TEST}"
}
trap restore_bindings EXIT

# Regenerate BOTH targets into the decoder checkout; compare; always restore.
# The generator's default sibling layout does not apply when decoder-rs is a
# submodule, so pass both headers explicitly.
(cd "${DECODER_RS}" && \
    python3 tools/gen_eqstructs.py live "${REPO}/src/backend/live/everquest.h" >/dev/null 2>&1 && \
    python3 tools/gen_eqstructs.py test "${REPO}/src/backend/test/everquest.h" >/dev/null 2>&1)

diff -q "${SAVED_LIVE}" "${BINDINGS_LIVE}" >/dev/null 2>&1 || STALE=1
diff -q "${SAVED_TEST}" "${BINDINGS_TEST}" >/dev/null 2>&1 || STALE=1

restore_bindings
trap - EXIT

if [[ "${STALE}" -eq 1 ]]; then
    echo ""
    echo "ERROR: scry-decoder-rs bindings are stale." >&2
    echo "       everquest.h changed but bindings.rs was not regenerated." >&2
    echo "       Run the generator for the Live and Test headers, then update the decoder pin." >&2
    echo "       Then commit and push scry-decoder-rs before retrying." >&2
    exit 1
fi

echo "pre-push: Rust bindings are up-to-date (live + test)."
